{
  "manifestVersion": 1,
  "id": "neo-project-manage",
  "name": "项目管理",
  "version": "2.1.2",
  "description": "项目与任务管理工具。支持 Agent 读取项目数据、创建任务。",
  "minAppVersion": "0.159.0",
  "trust": "full-access",
  "ui": {
    "hostCapabilities": [
      "external.open",
      "clipboard.writeText"
    ]
  },
  "contributes": {
    "page": {
      "title": "项目管理",
      "route": "/page",
      "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"4\" width=\"4\" height=\"5\" rx=\"1\"/><rect x=\"10\" y=\"4\" width=\"4\" height=\"9\" rx=\"1\"/><rect x=\"17\" y=\"4\" width=\"4\" height=\"7\" rx=\"1\"/><path d=\"M3 14h4v5\"/><path d=\"M10 17h4v2\"/><path d=\"M17 15h4v4\"/></svg>"
    },
    "routes": [
      "./routes/ui.js"
    ],
    "tools": [
      "./tools/create-project-set.js",
      "./tools/create-project.js",
      "./tools/create-task.js",
      "./tools/create-tasks.js",
      "./tools/create-annotation.js",
      "./tools/create-annotations.js",
      "./tools/delete-project-set.js",
      "./tools/delete-project.js",
      "./tools/delete-task.js",
      "./tools/delete-tasks.js",
      "./tools/delete-annotation.js",
      "./tools/delete-annotations.js",
      "./tools/get-project.js",
      "./tools/get-task.js",
      "./tools/list-project-sets.js",
      "./tools/list-projects.js",
      "./tools/list-tasks.js",
      "./tools/list-annotations.js",
      "./tools/list-project-files.js",
      "./tools/get-project-file.js",
      "./tools/update-project-set.js",
      "./tools/update-project.js",
      "./tools/update-task.js",
      "./tools/update-annotation.js",
      "./tools/link-project-session.js",
      "./tools/list-project-sessions.js",
      "./tools/unlink-project-session.js",
      "./tools/get-project-summaries.js",
      "./tools/summarize-project.js",
      "./tools/ask-project.js",
      "./tools/get-project-risks.js",
      "./tools/list-project-risks.js",
      "./tools/import-plan-file.js",
      "./tools/confirm-annotations.js",
      "./tools/register-project-file.js",
      "./tools/list-members.js",
      "./tools/create-member.js",
      "./tools/update-member.js",
      "./tools/delete-member.js",
      "./tools/list-audit-logs.js",
      "./tools/create-plan.js",
      "./tools/update-plan.js",
      "./tools/delete-plan.js",
      "./tools/list-plans.js",
      "./tools/get-plan.js",
      "./tools/add-plan-comment.js",
      "./tools/delete-plan-comment.js",
      "./tools/convert-plan-to-task.js",
      "./tools/create-note.js",
      "./tools/update-note.js",
      "./tools/delete-note.js"
    ]
  },
  "dev": {
    "scenarios": [
      {
        "id": "smoke-readonly",
        "title": "只读冒烟：list 工具调用无异常",
        "description": "验证插件工具注册与数据访问链路（dev 槽位、无数据变更，可反复跑）",
        "steps": [
          {
            "invokeTool": {
              "name": "list_project_sets",
              "input": {}
            }
          },
          {
            "invokeTool": {
              "name": "list_projects",
              "input": {}
            }
          }
        ]
      }
    ]
  }
}
